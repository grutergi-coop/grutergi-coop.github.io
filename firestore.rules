rules_version = '2';
// ═══════════════════════════════════════════════════════════════
// 그루터기 사회적협동조합 — Firestore 보안 규칙 (v5, 2026-11-25: 지역·기기 종류·화면 폭·머문 시간 통계 칸 추가)
// 원칙: 기본은 모두 차단 · 필요한 것만 열기 · 공개 쓰기는 모양과 크기를 검사
//
// site/{doc}            홈 화면 내용          누구나 읽기 · 관리자만 쓰기
// notices/{id}          공고                  게시된 것만 누구나 읽기 · 관리자만 쓰기 (삭제 불가)
// inquiries/{id}        서면 문의             누구나 남기기(검사) · 관리자만 읽기/처리/파기
// members/{uid}         조합원 명부           본인 신청(승인 전) · 본인 읽기 · 관리자 처리
// admins/{uid}          관리자 목록           본인 확인만 · 콘솔에서만 추가
// adminPins/{uid}       관리자 PIN 확인값     아무도 못 읽음 · 처음 1번 본인이 만듦 · 바꾸기는 PIN 확인 뒤
// adminUnlock/{uid}     PIN 확인 표시         아무도 못 읽음 · PIN이 맞을 때만 기록 · 12시간 유효
// visits/{day}          방문 통계             숫자를 1씩만 올릴 수 있음(시간대·기기·경로 갈래별) · 관리자만 읽기
// visitx/{day}          방문 통계 더 보기      숫자를 1씩만 올릴 수 있음(지역·기기 종류·화면 폭·머문 시간) · 관리자만 읽기
// errors/{id}           오류 알림판           모양 검사 후 기록 · 관리자만 읽기
// loginLogs/{id}        로그인 기록           본인 것만 남기기 · 관리자만 읽기 · 수정/삭제 불가
// sessions/{uid}        접속 현황             본인 것만 갱신 · 관리자만 읽기
// auditLog/{id}         관리자 활동 기록      관리자만 남기기/읽기 · 수정/삭제 불가
// snapshots/{id}        타임머신(저장 전 보관) 관리자만
// securityConfig/main   보안 설정             로그인한 사람 읽기 · 관리자만 쓰기
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // 관리자 = 등록된 계정(admins) + 12시간 안에 PIN을 맞힘(adminUnlock). 둘 다 있어야 관리자 권한이 열림
    function adminBase() {
      return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function unlocked() {
      return exists(/databases/$(database)/documents/adminUnlock/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUnlock/$(request.auth.uid)).data.at + duration.value(12, 'h') > request.time;
    }
    function isAdmin() { return adminBase() && unlocked(); }
    function isApproved() {
      return verified()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved == true;
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function incOne(k) {
      return !(k in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data[k] == resource.data.get(k, 0) + 1;
    }

    // ── 홈 화면 내용
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.size() < 60;
    }

    // ── 공고 (공식 공고이므로 삭제하지 않고 비공개 전환 + 변경 이력으로 관리)
    match /notices/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && str(request.resource.data.title, 200)
        && request.resource.data.published is bool
        && request.resource.data.items is list && request.resource.data.items.size() <= 30
        && request.resource.data.history is list && request.resource.data.history.size() >= 1;
      allow delete: if false;
    }

    // ── 서면 문의 (누구나 남김 · 내용과 크기 검사 · 처리 상태는 관리자만)
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','category','message','agree','status','createdAt','page'])
        && str(request.resource.data.name, 40) && request.resource.data.name.size() >= 1
        && str(request.resource.data.contact, 100) && request.resource.data.contact.size() >= 5
        && request.resource.data.category in ['조합 가입','어린이집','후원','기타']
        && str(request.resource.data.message, 2000) && request.resource.data.message.size() >= 10
        && request.resource.data.agree == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.page, 100);
      allow read, update, delete: if isAdmin();
    }

    // ── 조합원 명부
    match /members/{uid} {
      allow get: if (verified() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','name','approved','createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.name, 40)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ── 총회·이사회 자료
    match /meetings/{id} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // ── 관리자 목록 (콘솔에서만 추가)
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ── 관리자 PIN (확인값만 저장 · PIN 자체는 저장하지 않음 · 누구도 읽을 수 없음)
    match /adminPins/{uid} {
      function pinShape() {
        return request.resource.data.keys().hasOnly(['h','at'])
          && request.resource.data.h is string && request.resource.data.h.matches('^[0-9a-f]{64}$')
          && request.resource.data.at == request.time;
      }
      allow read: if false;
      allow create: if adminBase() && request.auth.uid == uid && pinShape();   // 처음 한 번 (이미 있으면 만들 수 없음)
      allow update: if isAdmin() && request.auth.uid == uid && pinShape();     // 바꾸기는 PIN 확인 뒤에만
      allow delete: if false;
    }

    // ── PIN 확인 표시 (맞는 PIN 확인값을 보낼 때만 기록됨 · 기록 시각부터 12시간 관리자 권한)
    match /adminUnlock/{uid} {
      allow read: if false;
      allow create, update: if adminBase() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['p','at'])
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/adminPins/$(uid))
        && request.resource.data.p == get(/databases/$(database)/documents/adminPins/$(uid)).data.h;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 방문 수 (하루 문서 하나 · 정해진 칸만 1씩 증가 · 개인 식별 정보 없음)
    //   칸: 합계 · 화면 종류 · 기기 크기 · 시간대(h00~h23) · 방문자(uv)·처음(nv)/다시(rv) · 운영체제(os_) · 브라우저(br_) · 들어온 경로(src_)
    //   한 번에 최대 9칸까지, 칸마다 정확히 1씩만 올릴 수 있음 · 지우기는 관리자만
    match /visits/{day} {
      function visitKeys() {
        return [
          'total','home','notice','member','admin','other','mobile','tablet','desktop','h00','h01','h02',
          'h03','h04','h05','h06','h07','h08','h09','h10','h11','h12','h13','h14',
          'h15','h16','h17','h18','h19','h20','h21','h22','h23','uv','nv','rv',
          'os_ios','os_android','os_win','os_mac','os_etc','br_kakao','br_naver','br_samsung','br_edge','br_chrome','br_safari','br_etc',
          'src_direct','src_search','src_sns','src_etc'
        ];
      }
      // 바뀐 칸(a)에 들어 있으면 정확히 1만 늘었는지 확인
      function inc1(a, k) {
        return !(k in a) || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      function allInc(a) {
        return inc1(a, 'total') && inc1(a, 'home') && inc1(a, 'notice') && inc1(a, 'member') && inc1(a, 'admin') && inc1(a, 'other')
          && inc1(a, 'mobile') && inc1(a, 'tablet') && inc1(a, 'desktop') && inc1(a, 'h00') && inc1(a, 'h01') && inc1(a, 'h02')
          && inc1(a, 'h03') && inc1(a, 'h04') && inc1(a, 'h05') && inc1(a, 'h06') && inc1(a, 'h07') && inc1(a, 'h08')
          && inc1(a, 'h09') && inc1(a, 'h10') && inc1(a, 'h11') && inc1(a, 'h12') && inc1(a, 'h13') && inc1(a, 'h14')
          && inc1(a, 'h15') && inc1(a, 'h16') && inc1(a, 'h17') && inc1(a, 'h18') && inc1(a, 'h19') && inc1(a, 'h20')
          && inc1(a, 'h21') && inc1(a, 'h22') && inc1(a, 'h23') && inc1(a, 'uv') && inc1(a, 'nv') && inc1(a, 'rv')
          && inc1(a, 'os_ios') && inc1(a, 'os_android') && inc1(a, 'os_win') && inc1(a, 'os_mac') && inc1(a, 'os_etc') && inc1(a, 'br_kakao')
          && inc1(a, 'br_naver') && inc1(a, 'br_samsung') && inc1(a, 'br_edge') && inc1(a, 'br_chrome') && inc1(a, 'br_safari') && inc1(a, 'br_etc')
          && inc1(a, 'src_direct') && inc1(a, 'src_search') && inc1(a, 'src_sns') && inc1(a, 'src_etc');
      }
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(visitKeys())
        && request.resource.data.keys().size() <= 9
        && request.resource.data.total == 1
        && request.resource.data.values().hasOnly([1]);
      allow update: if request.resource.data.keys().hasOnly(visitKeys())
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 9
        && allInc(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin();
    }

    // ── 방문 수 더 보기 (하루 문서 하나 · 위와 같은 방식 · 칸이 많아 문서를 나눔)
    //   칸: 지역 시·도(rg_) · 기기 종류(dv_) · 화면 폭(sc_) · 머문 시간(st_) · 첫 화면 내려 본 정도(sd_)
    //   한 번에 최대 3칸까지, 칸마다 정확히 1씩만 올릴 수 있음 · 지우기는 관리자만
    match /visitx/{day} {
      function xKeys() {
        return [
          'rg_seoul','rg_busan','rg_daegu','rg_incheon','rg_gwangju','rg_daejeon','rg_ulsan','rg_sejong','rg_gyeonggi','rg_gangwon','rg_chungbuk','rg_chungnam',
          'rg_jeonbuk','rg_jeonnam','rg_gyeongbuk','rg_gyeongnam','rg_jeju','rg_abroad','rg_etc','dv_iphone','dv_ipad','dv_galaxy','dv_galtab','dv_android',
          'dv_mac','dv_win','dv_etc','sc_1','sc_2','sc_3','sc_4','sc_5','st_10','st_30','st_60','st_180',
          'sd_25','sd_50','sd_75','sd_100'
        ];
      }
      function inc1(a, k) {
        return !(k in a) || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      function allInc(a) {
        return inc1(a, 'rg_seoul') && inc1(a, 'rg_busan') && inc1(a, 'rg_daegu') && inc1(a, 'rg_incheon') && inc1(a, 'rg_gwangju') && inc1(a, 'rg_daejeon')
          && inc1(a, 'rg_ulsan') && inc1(a, 'rg_sejong') && inc1(a, 'rg_gyeonggi') && inc1(a, 'rg_gangwon') && inc1(a, 'rg_chungbuk') && inc1(a, 'rg_chungnam')
          && inc1(a, 'rg_jeonbuk') && inc1(a, 'rg_jeonnam') && inc1(a, 'rg_gyeongbuk') && inc1(a, 'rg_gyeongnam') && inc1(a, 'rg_jeju') && inc1(a, 'rg_abroad')
          && inc1(a, 'rg_etc') && inc1(a, 'dv_iphone') && inc1(a, 'dv_ipad') && inc1(a, 'dv_galaxy') && inc1(a, 'dv_galtab') && inc1(a, 'dv_android')
          && inc1(a, 'dv_mac') && inc1(a, 'dv_win') && inc1(a, 'dv_etc') && inc1(a, 'sc_1') && inc1(a, 'sc_2') && inc1(a, 'sc_3')
          && inc1(a, 'sc_4') && inc1(a, 'sc_5') && inc1(a, 'st_10') && inc1(a, 'st_30') && inc1(a, 'st_60') && inc1(a, 'st_180')
          && inc1(a, 'sd_25') && inc1(a, 'sd_50') && inc1(a, 'sd_75') && inc1(a, 'sd_100');
      }
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(xKeys())
        && request.resource.data.keys().size() <= 3
        && request.resource.data.values().hasOnly([1]);
      allow update: if request.resource.data.keys().hasOnly(xKeys())
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 3
        && allInc(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin();
    }

    // ── 오류 알림판 (같은 오류는 문서 하나 · 횟수만 증가 · 입력 자료는 보내지 않음)
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['msg','page','count','firstAt','lastAt'])
        && str(request.resource.data.msg, 300) && str(request.resource.data.page, 100)
        && request.resource.data.count == 1
        && request.resource.data.firstAt == request.time && request.resource.data.lastAt == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','lastAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastAt == request.time;
    }

    // ── 로그인 기록 (본인 것만 남김 · 고칠 수 없음)
    match /loginLogs/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','type','at','device','page'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['login','logout','timeout','denied']
        && request.resource.data.at == request.time
        && str(request.resource.data.device, 20) && str(request.resource.data.page, 100);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── 접속 현황 (하트비트)
    match /sessions/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','page','device','lastSeen','role'])
        && request.resource.data.uid == uid
        && request.resource.data.lastSeen == request.time
        && (request.resource.data.role == 'member' || (request.resource.data.role == 'admin' && isAdmin()));
      allow read: if isAdmin();
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ── 관리자 활동 기록 (지울 수 없음)
    match /auditLog/{id} {
      allow create: if isAdmin()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── 타임머신 (저장 직전 내용 보관)
    match /snapshots/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // ── 보안 설정
    match /securityConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.idleMinutes is int
        && request.resource.data.idleMinutes >= 5 && request.resource.data.idleMinutes <= 120;
    }

    // ── 그 밖의 모든 것은 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
